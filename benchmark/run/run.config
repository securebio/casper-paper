/***************************************************************************
| mgs-workflow RUN config for the CASPER pipeline benchmark                |
|                                                                          |
| Pinned to the version the manuscript reports: workflow 3.0.1, index      |
| 20250825. Check out tag 3.0.1.9 rather than 3.0.1.0 -- results and       |
| schema are identical across the 3.0.1 line (point releases only), but    |
| 3.0.1.9 fixes the ec2_local profile, which without it cannot reach S3.   |
***************************************************************************/

params {
    mode     = "run"
    platform = "illumina"

    // Working and output root, overridable with BENCHMARK_BASE. Put this on instance
    // storage, not EBS: the run writes intermediates far larger than the ~12 GB of input.
    base_dir = System.getenv("BENCHMARK_BASE") ?: "/scratch/vv-benchmark"

    // Index 20250825, staged under base_dir beforehand. Must point at the *output*
    // subdirectory of an index build, not at its results/.
    ref_dir  = "${base_dir}/ref/20250825/output"

    sample_sheet = "${launchDir}/samplesheet.csv"
    adapters     = "${projectDir}/ref/adapters.fasta"

    // The manuscript's setting, and the parameter that most shapes the result: it is the
    // threshold at which an alignment is called a viral hit. Record it with any output.
    bt2_score_threshold = 20

    // PROFILE is not part of this benchmark -- it subsamples, and the VV workflow does not --
    // but the RUN workflow always executes it. Kept at the production value so the run is a
    // faithful reproduction rather than a special case; it costs the Kraken2 database load.
    n_reads_profile = 1000000

    cutadapt_error_rate = 0.33
    bracken_threshold   = 1
    random_seed         = "17310"

    // BLAST validation off: it is a separate check against core_nt, not part of the
    // assignment path being benchmarked, and it would dominate runtime.
    blast_db_prefix      = "core_nt"
    blast_viral_fraction = 0
    blast_min_frac       = 0.9
    blast_max_rank       = 10
    blast_perc_id        = 60
    blast_qcov_hsp_perc  = 30

    taxid_artificial = "81077"
}

workDir = "${params.base_dir}/work"

// The pipeline's own ec2_local profile mounts only $HOME/.aws into containers, while the
// AWS Batch profiles additionally mount the shared directory holding large reference
// files. That mount is not optional: the Kraken2 step rsyncs its database out of ref_dir
// from inside the container, so without it the task fails with
//
//     rsync: change_dir ".../kraken_db" failed: No such file or directory (2)
//
// This profile is ec2_local plus that mount. Defined here rather than by editing the
// pipeline, so the workflow checkout stays exactly as released.
profiles {
    vv_local {
        wave.enabled = false
        fusion.enabled = false
        process.errorStrategy = "finish"
        docker.runOptions = "-v ${params.base_dir}:${params.base_dir}" +
            ' -v $HOME/.aws:/root/.aws' +
            ' -e AWS_ACCESS_KEY_ID=$AWS_ACCESS_KEY_ID -e AWS_SECRET_ACCESS_KEY=$AWS_SECRET_ACCESS_KEY'
    }
}

includeConfig "${projectDir}/configs/logging.config"
includeConfig "${projectDir}/configs/containers.config"
includeConfig "${projectDir}/configs/resources.config"
includeConfig "${projectDir}/configs/profiles.config"
includeConfig "${projectDir}/configs/output.config"
